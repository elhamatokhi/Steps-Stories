<%- include('partials/header',{title:' All posts '}) %>
<h1> Your timeline! </h1>

<% if (posts.length === 0) { %>
    <p>No posts to display</p>
  <% } %>
  
<% posts.forEach((post,index) => { %>
    <div class="post">
        <h2> <%= post.TripTitle %> </h2>
        <p>Date: <%= post.date %></p>
        <p>Location: <%= post.location  %></p>
        <p>Reflection: <%= post.story  %></p>
        <p>Tags: <%= post.tags %></p>
        <img src="<%= post.image %>" alt="Trip Image">
        <div>
        <a href="/edit/<%= index %>">Edit</a>
        <form method="post" action="/delete/<%= index %>">
            <button onclick="return confirm('Are you sure?')">Delete</button>
        </form>
            </div>
    </div>
<% }) %>

<a href="/">Home</a>
<%- include('partials/footer') %>