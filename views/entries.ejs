<%- include('partials/header', { title: 'All posts' }) %>
<div class="container my-4">
    <h1 class="mb-4 text-center">Your Timeline!</h1>

    <% if (posts.length === 0) { %>
        <div class="alert alert-info text-center">No trips available.</div>
    <% } %>
  
    <div class="row row-cols-1 row-cols-md-2 g-4">
        <% posts.forEach((post, index) => { %>
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="<%= post.image %>" alt="Trip Image" class="card-img-top" style="height: 20rem;">
                    <div class="card-body">
                        <h5 class="card-title"><%= post.TripTitle %></h5>
                        <p class="card-text"><strong>Date:</strong> <%= post.date %></p>
                        <p class="card-text"><strong>Location:</strong> <%= post.location %></p>
                        <p class="card-text"><strong>Reflection:</strong> <%= post.story %></p>
                        <p class="card-text"><strong>Tags:</strong> <%= post.tags %></p>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a href="/edit/<%= index %>" class="btn btn-warning btn-sm">Edit</a>
                        <form method="post" action="/delete/<%= index %>" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
  
    <div class="text-center mt-4">
        <a href="/" class="btn btn-primary">Go Back to Home</a>
    </div>
</div>

<%- include('partials/footer') %>
